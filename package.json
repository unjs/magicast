{
  "name": "magicast",
  "type": "module",
  "version": "0.5.4",
  "packageManager": "pnpm@12.3.4",
  "description": "Modify a JS/TS file and write back magically just like JSON!",
  "license": "MIT",
  "repository": "unjs/magicast",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core.js",
    "./helpers": "./dist/helpers.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsx ./scripts/vendor.ts",
    "dev": "vitest dev",
    "dev:ui": "vitest dev --ui",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "release": "pnpm run test run && bumpp",
    "test": "vitest",
    "test:build": "TEST_BUILD=true vitest",
    "test:full": "pnpm run test --run && pnpm run build && pnpm run test:build --run"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/types": "^8.0.4",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "ast-types": "^0.16.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "giget": "^3.3.1",
    "jiti": "^2.7.0",
    "magicast": "workspace:*",
    "nano-staged": "^1.0.2",
    "prettier": "^3.9.6",
    "recast": "^0.24.0",
    "simple-git-hooks": "^2.14.0",
    "source-map": "npm:source-map-js@latest",
    "taze": "^21.1.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "inlinedDependencies": {
    "recast": "0.24.0",
    "source-map-js": "1.2.1"
  }
}
